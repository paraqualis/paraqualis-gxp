# Copy this file to ".env" and fill in your real key.
# .env is git-ignored and will never be committed or pushed — this template is safe to share.
#
# openFDA API key — free, from https://open.fda.gov/apis/authentication/
# Raises your limit from 1,000 to 120,000 requests/day. Passed to the API as ?api_key=...
OPENFDA_API_KEY=your-key-here
